{
  "name": "opencode-api-tracer",
  "version": "0.1.3",
  "description": "OpenCode plugin that traces LLM fetch request/response payloads to local JSONL files.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "opencode-api-radar": "./scripts/opencode_api_radar.py",
    "opencode-api-tracer": "./scripts/opencode_api_radar.py"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tracer.js",
    "dist/tracer.d.ts",
    "scripts/opencode_api_radar.py",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js && npm run test:viewer",
    "test:viewer": "python3 -m unittest discover -s scripts -p '*_test.py'",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "trace",
    "llm",
    "fetch"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
